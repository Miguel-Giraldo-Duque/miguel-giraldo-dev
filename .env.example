# stub | resend | nodemailer
# stub logs the message and does not deliver it. It is the default.
EMAIL_PROVIDER=stub

# Inbox that should receive contact form messages.
CONTACT_TO_EMAIL=

# From address. Resend requires a verified domain.
# Example: Miguel Giraldo <hola@miguelgd.com>
EMAIL_FROM=

# Resend (https://resend.com)
RESEND_API_KEY=

# Nodemailer SMTP. For Gmail, use an app password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
